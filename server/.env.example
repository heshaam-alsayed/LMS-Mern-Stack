PORT=8000
ORIGIN=http://localhost:3000,http://localhost:4000,http://localhost:5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB (local or Atlas)
DB_URL=mongodb://localhost:27017/lms

# Redis (local or Upstash)
REDIS_URL=redis://localhost:6379

ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret
ACCESS_TOKEN_EXPIRE=5m
REFRESH_TOKEN_EXPIRE=7d

JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=5m
RESET_TOKEN_EXPIRE=10m

# Cloudinary
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_cloud_api_key
CLOUD_API_SECRET=your_cloud_api_secret

# Stripe
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# VdoCipher
VIDEO_CIPHER_API_SECRET=your_vdocipher_api_secret

# SMTP (Nodemailer / Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SERVICE=gmail
SMTP_MAIL=your_email@gmail.com
SMTP_PASSWORD=your_smtp_password